---
/**
 * サービス／フロー用イラスト枠（Higgsfield生成・自社利用）
 */
interface Props {
  name: 'sasae' | 'otomo' | 'mukae' | 'consult' | 'meeting' | 'contract' | 'start';
  alt: string;
  class?: string;
}
import { withBase } from '../lib/site';
const { name, alt, class: className = '' } = Astro.props;
const src = `/images/illustrations/${name}.png`;
---

<div class:list={['relative overflow-hidden bg-[#e8f1fa]', className]}>
  <img
    src={withBase(src)}
    alt={alt}
    class="h-full w-full object-cover"
    loading="lazy"
    width="1280"
    height="720"
  />
</div>
