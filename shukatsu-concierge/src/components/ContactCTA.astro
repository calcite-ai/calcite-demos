---
import { site, withBase } from '../lib/site';
---

<section class="border-t bg-brand-dark text-white">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="text-2xl font-bold tracking-tight">無料相談・お問い合わせ</h2>
      <p class="mt-3 text-white/85 text-[15px]">
        一生涯の生活支援を窓口ひとつでお受けします。身元保証や死後の手続きのご相談も、その一環として対応します。専門職の方からのご相談も歓迎です。
      </p>
      <p class="mt-4 text-sm text-accent">フリーダイヤル {site.phoneFree}　／　TEL {site.phone}</p>
      <p class="mt-1 text-xs text-white/65">電話受付 {site.phoneHours}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={`tel:${site.phoneFree.replaceAll('-', '')}`} class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-dark hover:bg-accent-soft transition md:hidden">フリーダイヤルで相談</a>
      <a href={withBase('/contact/')} class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition">メールで相談</a>
    </div>
  </div>
</section>
