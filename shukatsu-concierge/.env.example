# --- Claude API（会社発行キーを後入れ。個人キーを本番Secretsに置かない）---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# DRAFT_COUNT=3

# --- WordPress REST（コラム下書き投入。Application Password 再発行後に設定）---
# WP_REST_URL=https://shukatsu.or.jp/wp-json
# WP_DRAFT_USER=shukatsu-draftbot
# WP_APP_PASSWORD=
# WP_SITE_ADMIN_URL=https://shukatsu.or.jp/wp/wp-admin
# 本番のコラム「ニュース」カテゴリ ID（要確認。変更時は管理画面で再確認）
COLUMN_CATEGORY_IDS=14

# --- 通知（任意・Slack Incoming Webhook 等）---
# NOTIFY_WEBHOOK_URL=

# 詳細: docs/content-ops-secrets.md / docs/wp-draft-user-setup.md

# --- ニュース月次自動公開（本番は wp-config の SHUKATSU_NEWS_CRON_TOKEN）---
# SHUKATSU_NEWS_CRON_TOKEN=
# SHUKATSU_NEWS_CRON_URL=https://shukatsu.or.jp/wp-json/shukatsu/v1/monthly-news/run
